{
  "name": "dsh-session-bridge",
  "version": "0.8.0",
  "description": "会话桥（dsh-session-bridge）：通过提示词创建新的主会话（顶层 UI 会话）、向任意会话发送消息、等待会话的下一条回复、读取会话消息，并按会话名或 id 跨工作区查找会话；此外支持监控/调度主任务（含思维链循环检测 → 自动中断并把任务转移到新会话）、子代理处置与归档/取消归档会话。",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heartmove/dsh-session-bridge.git"
  },
  "homepage": "https://github.com/heartmove/dsh-session-bridge#readme",
  "bugs": {
    "url": "https://github.com/heartmove/dsh-session-bridge/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "plugin",
    "session",
    "session-bridge",
    "bridge"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-0"
  },
  "packageManager": "pnpm@11.21.0",
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "scripts",
    "src",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir lib/types && tsdown",
    "build:client": "tsdown",
    "check:compat": "node scripts/check-dsh-compat.mjs",
    "smoke": "node scripts/smoke-bundle.mjs",
    "test": "node scripts/test-peer-floor.mjs && node --experimental-strip-types scripts/test-bridge-core.mjs && node --experimental-strip-types scripts/test-loop-guard.mjs && node --experimental-strip-types scripts/test-handoff.mjs && node --experimental-strip-types scripts/test-monitor-loop.mjs && node --experimental-strip-types scripts/test-tools-create.mjs && node --experimental-strip-types scripts/test-config.mjs && node --experimental-strip-types scripts/test-tools-archived.mjs && node --experimental-strip-types --test scripts/test-v4.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.1.7-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.7-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-0",
    "@deepseek-ai/dsh-session": ">=0.1.7-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.7-0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-0",
    "@deepseek-ai/dsh-workspace": ">=0.1.7-0",
    "@deepseek-ai/schemastery": "^3.18.4",
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.2.2-alpha.3",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-alpha.3",
    "@deepseek-ai/dsh-brand": ">=0.2.2-alpha.3",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": ">=0.2.2-alpha.3",
    "@deepseek-ai/dsh-scope": ">=0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": ">=0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-format-catalog": ">=0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": ">=0.2.2-alpha.3",
    "@deepseek-ai/dsh-util-values": ">=0.2.2-alpha.3",
    "@deepseek-ai/dsh-workspace": ">=0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.6-alpha.2",
    "@types/node": "^24.0.0",
    "cordis": "npm:@deepseek-ai/cordis@4.0.6-alpha.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  }
}
